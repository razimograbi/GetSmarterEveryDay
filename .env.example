# Copy this file to .env and fill it in.

# OAuth 2.0 Client ID (type "Web application") from
# https://console.cloud.google.com/apis/credentials
# Add http://localhost:3000 to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Port the app listens on.
PORT=3000

# Turn on the name-only "dev" sign-in even when Google sign-in is configured.
# Handy for testing on a phone over your Wi-Fi, where Google sign-in won't work
# on a plain http://192.168.x.x address. Leave at 0 otherwise.
# Anyone who types a name gets that name's account, so this is never allowed in production.
DEV_LOGIN=0

# Set to "production" on the real server. Then dev sign-in is always off, the server
# refuses to start without GOOGLE_CLIENT_ID, and cookies are marked Secure (HTTPS only).
NODE_ENV=

# Where the database lives. On a host whose disk is wiped on redeploy, point this
# at a persistent volume (for example DATA_DIR=/var/lib/smarts).
DATA_DIR=

# Who can open the admin page (Progress > Review question reports): comma-separated Google
# emails. Dev sign-in accounts can be listed by id, e.g. dev:razi for the name "Razi".
ADMIN_USERS=

# Set to 1 when the app runs behind a reverse proxy (Caddy, nginx, Fly.io, Railway...).
# Rate limits are counted per player address; behind a proxy that address comes from the
# X-Forwarded-For header. Leave at 0 when players connect to Node directly, or anyone
# could fake the header.
TRUST_PROXY=0

# Address Node listens on. Behind a reverse proxy use 127.0.0.1, so only the proxy can reach it.
# HOST=0.0.0.0

# How many players may use the app at once (default 100). More are shown a "full" page.
# MAX_PLAYERS=100

# Optional overrides: the database file itself (default: $DATA_DIR/smarts.db), and
# Secure cookies (default: on in production, off otherwise).
# DB_FILE=
# SECURE_COOKIES=1
