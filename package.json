{
  "name": "smarts",
  "version": "0.1.0",
  "private": true,
  "description": "A mobile-first picture quiz with Google sign-in and progress tracking.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch-path=server --watch-path=shared server/index.js",
    "test": "node --test tests/",
    "validate": "node scripts/validate.js",
    "check-images": "node scripts/check-images.js",
    "fetch-images": "node scripts/fetch-images.js",
    "prune-images": "node scripts/prune-images.js",
    "fetch-covers": "node scripts/fetch-covers.js",
    "backup": "node scripts/backup.js",
    "fetch-signs": "node scripts/fetch-signs.js",
    "fetch-credits": "node scripts/fetch-credits.js"
  }
}
